# Klic pro Gemini API (transkripce videi bez titulku + embeddingy pro semanticke hledani)
GEMINI_API_KEY=
# Volitelne: YouTube Data API v3 (presna metadata: datum publikace, delka, popis). Bez nej se pouzije yt-dlp.
YOUTUBE_API_KEY=
# Volitelne: proxy pro stahovani titulku (YouTube blokuje IP cloudovych providery). Napr. http://user:pass@host:port
YTINDEX_PROXY_URL=
# Volitelne: Webshare rezidencni proxy (doporuceno autorem youtube-transcript-api)
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
